<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.flightdeck.hostd</string>
  <!-- Inside its own helper app, never the main app's Contents/MacOS: a bundle-less hostd
       checks in with LaunchServices as Flight Deck itself and swallows the app's launches. -->
  <key>BundleProgram</key><string>Contents/Library/LoginItems/Flight Deck Host.app/Contents/MacOS/flightdeck-hostd</string>
  <key>ProgramArguments</key><array><string>flightdeck-hostd</string><string>serve</string></array>
  <!-- Aqua: run inside the GUI login session, which XCTest UI runs (sub-project C) need. -->
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <!-- launchd's default, spelled out because DelegationHost.shutdown's defaults are sized to
       it: on SIGTERM hostd downs services and ends runs, and launchd SIGKILLs it after this. -->
  <key>ExitTimeOut</key><integer>20</integer>
</dict></plist>
