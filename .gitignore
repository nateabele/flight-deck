# Written to disk by `xcodegen generate` from project.yml's FlightDeckMobile `info:` block
# (needed for NSBonjourServices, an array — INFOPLIST_KEY_ build settings can't express one).
# Every other target synthesizes its Info.plist at build time via GENERATE_INFOPLIST_FILE;
# this is the one physical copy, regenerated identically on every build, so it stays out of
# git like the rest of the generated project.
Sources/FlightDeckMobile/Info.plist
vendor/.zig-toolchain
vendor/.build-shim
*.profraw
scripts/.smoke.log
scripts/.release-build.log
scripts/.adapterprobe.log
scripts/adapterprobe/corpus/
.superpowers/
.claude/
.aider*

# Claude lays its mod type declarations into a plugin folder whenever it loads or tests one
# ("regenerate rather than edit"). Never commit them; the installed claude is the authority.
Resources/ClaudePlugin/.claude-plugin/types/
Resources/ClaudeUsagePlugin/.claude-plugin/types/
scripts/.capacity-ui.log
scripts/.capacity-ui.xcresult/
scripts/.capacity-ui-shots/
