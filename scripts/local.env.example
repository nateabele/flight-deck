# Copy to scripts/local.env (git-ignored) and fill in. Machine-specific settings live there
# rather than in tracked scripts, so no host name, address or login of anyone's network is
# ever committed to this public repo. Every variable can also be set in the environment, which
# wins over this file.

# ssh destination of the UI-test Mac that scripts/smoke-remote.sh (and so smoke.sh) runs the
# UI suite on — user@host, a Tailscale/MagicDNS name or an address.
FD_UITEST_HOST=

# ssh identity for FD_UITEST_HOST. Empty means ssh's own defaults and ~/.ssh/config.
FD_UITEST_SSH_KEY=
